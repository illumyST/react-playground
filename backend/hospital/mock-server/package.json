{
  "name": "@react-playground/hospital-mock-server",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.cjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@faker-js/faker": "10.4.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.2.0",
    "lodash": "4.18.1",
    "morgan": "1.11.0",
    "struct-fakerator": "3.3.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/lodash": "4.17.24",
    "@types/morgan": "1.9.10",
    "@types/node": "24.10.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
