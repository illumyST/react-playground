<?xml version="1.0" encoding="UTF-8"?>  
<configuration>  
    <system.webServer>  
        <iisnode nodeProcessCommandLine="C:\Program Files\nodejs\node.exe" />

        <handlers>
            <add name="nodejs" path="server.js" verb="*" modules="iisnode" resourceType="Unspecified" />
        </handlers>

        <rewrite>  
            <rules>
                <rule name="Express" stopProcessing="true">  
                    <match url="/*" />
                    <action type="Rewrite" url="server.js" />  
                </rule>
           </rules>
        </rewrite>
    </system.webServer>
</configuration>