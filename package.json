{
  "name": "react-playground",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20.17.0 <21",
    "pnpm": ">=9.0.0 <10"
  },
  "packageManager": "pnpm@9.12.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -s first \"node backend/copilotKit/runtime/server.js\" \"vite --mode development\"",
    "build": "tsc -b && vite build --mode production",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:copilot-runtime": "node backend/copilotKit/runtime/server.js",
    "setup:copilot-backend": "python3 -m venv backend/copilotKit/.venv && ./backend/copilotKit/.venv/bin/python -m pip install --upgrade pip && ./backend/copilotKit/.venv/bin/python -m pip install -r backend/copilotKit/requirements.txt",
    "dev:copilot-backend": "./backend/copilotKit/.venv/bin/python -m uvicorn backend.copilotKit.example_server:app --reload --host 0.0.0.0 --port 8000"
  },
  "dependencies": {
    "@copilotkit/react-core": "^1.51.3",
    "@copilotkit/react-ui": "^1.51.3",
    "@copilotkit/runtime": "^1.51.3",
    "@copilotkit/runtime-client-gql": "^1.51.3",
    "@copilotkit/shared": "1.51.3",
    "@phosphor-icons/react": "^2.1.10",
    "@remotion/player": "^4.0.462",
    "@tailwindcss/vite": "^4.3.0",
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.1",
    "clipboard": "^2.0.11",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "highcharts": "11.4.3",
    "highcharts-react-official": "3.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.0",
    "react-router-dom": "^6.30.3",
    "remotion": "^4.0.462",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "postcss": "^8.5.14",
    "prettier": "3.6.2",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "npm:rolldown-vite@7.1.14"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.1.14"
    }
  }
}
